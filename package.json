{
  "name": "parsanol",
  "version": "0.10.52",
  "description": "PARG artifact runtime for TypeScript \u2014 checksum-verified artifact load, wasm parse, bindings, schema-driven materialization",
  "type": "module",
  "main": "dist/runtime.js",
  "types": "dist/runtime.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./suite": "./dist/suite.js",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist/",
    "vendor/parsanol-wasm/",
    "vendor/parsanol-web/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npx tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "refresh-wasm": "bash scripts/refresh-wasm.sh",
    "prepublishOnly": "npm run build",
    "bench": "node bench/bench.mjs",
    "test:browser": "npm run build && python3 scripts/test-browser.py",
    "refresh-web-wasm": "python3 scripts/refresh-web-wasm.py",
    "refresh-wasm-candidate": "python3 scripts/build-wasm-candidate.py",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsanol/parsanol-ts.git"
  },
  "keywords": [
    "parser",
    "peg",
    "parg",
    "wasm",
    "rust"
  ],
  "private": false,
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
